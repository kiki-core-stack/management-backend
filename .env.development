# Base
ENVIRONMENT='development'
PROJECT_NAME='kiki-core-stack'

# Auth

## Origin of the admin frontend (e.g. https://admin.example.com); its hostname is the passkey rpId.
ADMIN_AUTH_ORIGIN=''

## Secrets of at least 32 bytes (no commas) encrypting stored secrets such as TOTP seeds, comma-separated for rotation
## (the first encrypts). Generate: openssl rand -base64 32
AUTH_SECRET_ENCRYPTION_KEYS=''

# Cookie session

## Secrets of at least 32 bytes (no commas), comma-separated for rotation (the first encrypts). Generate: openssl rand -base64 32
COOKIE_SESSION_KEYS=''

# Development

## Log a warning when a JSON response does not match its documented schema.
VALIDATE_RESPONSES=false

# Public
MONGODB_RS_HOST='127.0.0.1'
MONGODB_URI="mongodb://${MONGODB_RS_HOST}:27017/${PROJECT_NAME}-${ENVIRONMENT}?directConnection=true&replicaSet=rs0"
NPM_CONFIG_REGISTRY='https://registry.npmjs.org'
REDIS_URL='redis://127.0.0.1:6379'

# Server
SERVER_HOST='127.0.0.1'
SERVER_PORT=8080

# Storage

## S3-compatible storage holding the buckets <PROJECT_NAME>-<ENVIRONMENT>-public and -private (e.g. the RustFS of
## infra-services). Empty region uses us-east-1; R2 uses 'auto'.
FILE_STORAGE_S3_ACCESS_KEY_ID="${PROJECT_NAME}-${ENVIRONMENT}"
FILE_STORAGE_S3_ENDPOINT=''
FILE_STORAGE_S3_REGION=''
FILE_STORAGE_S3_SECRET_ACCESS_KEY=''

# ws.io
WS_IO_AUTH_KEY=''
WS_IO_INTROSPECTION_TOKEN='' # must contain at least 32 bytes
WS_IO_SERVER_BASE_URL=''
