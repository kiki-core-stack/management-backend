{
  "type": "module",
  "private": true,
  "scripts": {
    "base:dev": "NODE_ENV=development bun --env-file=./.env.development.local",
    "base:prod": "NODE_ENV=production bun --env-file=./.env.production.local",
    "bootstrap:dev": "bun run base:dev -- run ./src/core/bootstrap/index.ts",
    "bootstrap:prod": "bun run base:prod -- run ./src/core/bootstrap/index.ts",
    "build": "bun run base:prod -- run ./src/core/build.ts",
    "dev": "NODE_ENV=development nodemon",
    "knip:deps": "knip --dependencies",
    "knip:exports": "knip --exports",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "eslint --fix --max-warnings 0",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@kcs-project/pack": "git+https://github.com/kiki-core-stack/pack#fb9ed994c68e83e0eac117a6d6f1285da04a070e",
    "@kikiutils/micromatch": "^4.0.9",
    "@kikiutils/mongoose": "^9.0.2",
    "@kikiutils/shared": "^20.1.0",
    "@sylke/email-validation": "^1.0.0",
    "es-toolkit": "^1.53.1",
    "flat": "^6.0.1",
    "hono": "^4.13.16",
    "mongoose": "^9.12.0",
    "nanoid": "^6.0.2",
    "node-ciphers": "^6.1.5",
    "on-change": "^6.0.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@hono/swagger-ui": "^0.6.2",
    "@kikiutils/eslint-config": "^10.2.1",
    "@kikiutils/tsconfigs": "^7.0.0",
    "@scalar/hono-api-reference": "^0.12.18",
    "@types/bun": "^1.4.4",
    "@types/micromatch": "^4.0.10",
    "eslint": "^10.14.0",
    "knip": "^6.44.1",
    "mlly": "^1.8.2",
    "nodemon": "^3.1.14",
    "openapi3-ts": "^4.6.2",
    "pretty-bytes": "^7.2.0",
    "type-fest": "^5.10.0",
    "typescript": "^6.0.3",
    "unimport": "^7.0.2"
  },
  "overrides": {
    "@types/node": "^26.0.0",
    "typescript": "^6.0.3"
  }
